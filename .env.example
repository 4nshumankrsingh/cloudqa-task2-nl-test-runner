# Copy this file to .env and fill it in. Pick ONE provider.

# --- Gemini (works with a free key from Google AI Studio) ---
LLM_PROVIDER=gemini
LLM_API_KEY=your-key-here
LLM_MODEL=a-current-flash-model-name
LLM_REASONING_EFFORT=low

# --- Anthropic ---
# LLM_PROVIDER=anthropic
# LLM_API_KEY=your-key-here
# LLM_MODEL=claude-sonnet-5-5

# --- Other OpenAI-compatible providers: openai, groq, openrouter ---
# LLM_PROVIDER=openai
# LLM_API_KEY=your-key-here
# LLM_MODEL=model-name
# LLM_BASE_URL=   (optional override of the default endpoint)